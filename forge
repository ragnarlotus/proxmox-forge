#!/bin/bash
# Description: Main Forge CLI orchestrator. Acquires the single global Forge run lock, snapshots the effective configuration for the run, then dispatches commands without implementing domain logic.

set -u
# Never inherit an external path as the authoritative log for a new run.
unset FORGE_RUN_LOG FORGE_SCHEDULED_MODE

fail() {
  printf 'ERROR: %s\n' "$*" >&2
  # Failures before a target log exists must still be diagnosable in F141.
  if [[ -n "${FORGE_RUN_LOG:-}" ]]; then
    printf -v run_error '%q' "$*"
    if ! printf '%s level=ERROR event=run_error message=%s\n' \
      "$(date --iso-8601=seconds)" "$run_error" >> "$FORGE_RUN_LOG"; then
      printf 'WARNING: could not record Forge run error: %s\n' "$FORGE_RUN_LOG" >&2
    fi
  fi
  exit 1
}

# Resolve launcher symlinks before locating the repository components.
# A PATH symlink (e.g. /usr/local/bin/forge) is not the installation root.
FORGE_ENTRYPOINT="$(readlink -f -- "${BASH_SOURCE[0]}")" || {
  printf 'ERROR: could not resolve Forge executable path\n' >&2
  exit 1
}
FORGE_DIR="$(cd "$(dirname "$FORGE_ENTRYPOINT")" && pwd)" || {
  printf 'ERROR: could not determine Forge directory\n' >&2
  exit 1
}

# F246: user-facing presentation only; the validated configuration owns the
# language, never untrusted environment values or external updater output.
export FORGE_LANGUAGE=en
forge_tr() {
  python3 "$FORGE_DIR/lib/i18n/translate.py" "$@"
}

CONFIG_FILE="$FORGE_DIR/forge.conf.default"
LOCAL_CONFIG_FILE="$FORGE_DIR/forge.conf"
RUNTIME_GUARD_SCRIPT="$FORGE_DIR/lib/runtime/require-context.sh"
LOCK_FILE="/run/lock/proxmox-forge.lock"
LOCK_FD=200
PERSISTENT_SCRIPT="$FORGE_DIR/lib/runtime/persistent.sh"

[[ -r "$PERSISTENT_SCRIPT" ]] || {
  printf 'ERROR: Forge persistent session helper is not readable: %s\n' "$PERSISTENT_SCRIPT" >&2
  exit 1
}
# shellcheck source=/dev/null
source "$PERSISTENT_SCRIPT" || exit 1
forge_persistent_init || exit 1

# Reattachment is a CLI frontend action, not a new Forge run; the updater
# already owns the lock, and attempting to take it here would block access.
if [[ "${1:-}" == back ]]; then
  [[ $# -eq 1 ]] || { printf 'ERROR: usage: forge back\n' >&2; exit 1; }
  forge_persistent_back
  exit $?
fi

# An active persistent job is checked BEFORE the existing flock rejection, so
# the operator gets an actionable instruction even after reconnecting via SSH.
if [[ "${FORGE_PERSISTENT_INNER:-}" != 1 ]]; then
  case "${1:-}:${2:-}" in
    host:update|lxc:update|update:all)
      if forge_persistent_active; then
        printf 'ERROR: a persistent Forge update is already running. Execute: forge back\n' >&2
        exit 1
      fi
      ;;
  esac
fi

[[ -r "$RUNTIME_GUARD_SCRIPT" ]] || {
  printf 'ERROR: Forge runtime guard is not readable: %s\n' "$RUNTIME_GUARD_SCRIPT" >&2
  exit 1
}
command -v flock >/dev/null 2>&1 || {
  printf 'ERROR: flock is required for Forge runtime locking\n' >&2
  exit 1
}
[[ -d /run/lock && -w /run/lock ]] || {
  printf 'ERROR: Forge lock directory is not writable: /run/lock\n' >&2
  exit 1
}

# A self-update followed by re-exec must retain the SAME locked descriptor:
# reopening FD 200 would briefly release the lock between Forge revisions.
if [[ "${FORGE_SELF_UPDATE_REEXEC:-}" == 1 ]]; then
  unset FORGE_SELF_UPDATE_REEXEC
  [[ -e "/proc/$BASHPID/fd/$LOCK_FD" ]] || {
    printf 'ERROR: inherited Forge lock is unavailable\n' >&2
    exit 1
  }
  inherited_lock="$(readlink "/proc/$BASHPID/fd/$LOCK_FD")" || exit 1
  [[ "$inherited_lock" == "$LOCK_FILE" ]] || {
    printf 'ERROR: inherited Forge lock is not the expected lock file\n' >&2
    exit 1
  }
else
  exec 200<>"$LOCK_FILE" || {
    printf 'ERROR: could not open Forge run lock: %s\n' "$LOCK_FILE" >&2
    exit 1
  }
fi

# The tmux worker is created while its short-lived CLI parent holds the lock.
# Give that specific worker time to acquire the same lock after handoff.
if [[ "${FORGE_PERSISTENT_INNER:-}" == 1 ]]; then
  flock -w 15 "$LOCK_FD"
else
  flock -n "$LOCK_FD"
fi
if (( $? != 0 )); then
  holder="$(awk -F '\t' '
    $1 == "meta" && ($2 == "pid" || $2 == "run_id" || $2 == "command") {
      if (length(out)) out = out " ";
      out = out $2 "=" $3;
    }
    END { print out }
  ' "$LOCK_FILE" 2>/dev/null)"
  if [[ -z "$holder" ]]; then
    holder="$(head -n 1 "$LOCK_FILE" 2>/dev/null)"
  fi
  if [[ -n "$holder" ]]; then
    printf 'ERROR: another Forge execution is already running (%s)\n' "$holder" >&2
  else
    printf 'ERROR: another Forge execution is already running\n' >&2
  fi
  exit 1
fi

cleanup_run_state() {
  local exit_code=$? finished_epoch="" duration_seconds=""
  local -a fields=("run_id=$run_id" "exit_code=$exit_code")
  if [[ -n "${FORGE_RUN_LOG:-}" ]]; then
    # Do not invent an elapsed time when a clock read fails.
    finished_epoch="$(date +%s)" || finished_epoch=""
    if [[ "${run_started_epoch:-}" =~ ^[0-9]+$ && "$finished_epoch" =~ ^[0-9]+$ ]] &&
       (( finished_epoch >= run_started_epoch )); then
      duration_seconds=$((finished_epoch - run_started_epoch))
      fields+=("duration_seconds=$duration_seconds")
    fi
    bash "$FORGE_DIR/lib/logging/write.sh" "$FORGE_RUN_LOG" INFO run_end \
      "${fields[@]}" || \
      printf 'WARNING: could not record Forge run completion: %s\n' "$FORGE_RUN_LOG" >&2
    if [[ -n "$duration_seconds" ]]; then
      local duration=""
      if (( duration_seconds >= 3600 )); then
        printf -v duration '%d h %d m %d s' \
          "$((duration_seconds / 3600))" "$(((duration_seconds % 3600) / 60))" "$((duration_seconds % 60))"
      elif (( duration_seconds >= 60 )); then
        printf -v duration '%d m %d s' \
          "$((duration_seconds / 60))" "$((duration_seconds % 60))"
      else
        printf -v duration '%d s' "$duration_seconds"
      fi
      forge_tr cli.run_duration "duration=$duration"
    fi
  fi
  : > "$LOCK_FILE" 2>/dev/null || true
}
trap cleanup_run_state EXIT

run_id="$(date '+%Y%m%dT%H%M%S')-$$" || {
  printf 'ERROR: could not create Forge run identifier\n' >&2
  exit 1
}
command_name="${*:-none}"
printf 'meta\tpid\t%s\nmeta\trun_id\t%s\nmeta\tcommand\t%s\n' \
  "$$" "$run_id" "$command_name" > "$LOCK_FILE" || {
  printf 'ERROR: could not record Forge run lock metadata\n' >&2
  exit 1
}

export FORGE_CONTEXT=active
export FORGE_RUN_ID="$run_id"
export FORGE_LOCK_FILE="$LOCK_FILE"
export FORGE_LOCK_FD="$LOCK_FD"
export FORGE_RUNTIME_GUARD="$RUNTIME_GUARD_SCRIPT"
unset FORGE_RUNTIME_CONFIG_READY
unset FORGE_LXC_ENVIRONMENT_READY
unset FORGE_LXC_BACKUP_ONLY_VMIDS

HELP_SCRIPT="$FORGE_DIR/lib/cli/help.sh"
CONFIG_GET_SCRIPT="$FORGE_DIR/lib/config/get.sh"
CONFIG_SHOW_SCRIPT="$FORGE_DIR/lib/config/show.sh"
HOST_UPDATE_SCRIPT="$FORGE_DIR/lib/host/update.sh"
LXC_ENVIRONMENT_SCRIPT="$FORGE_DIR/lib/lxc/get-environment.sh"
LXC_LIST_TARGETS_SCRIPT="$FORGE_DIR/lib/lxc/list-targets.sh"
LXC_GET_TARGET_SCRIPT="$FORGE_DIR/lib/lxc/get-target.sh"
LXC_CONFLICTS_SCRIPT="$FORGE_DIR/lib/config/conflicts.sh"
LXC_UPDATE_SCRIPT="$FORGE_DIR/lib/lxc/update.sh"
UPDATE_ALL_SCRIPT="$FORGE_DIR/lib/workflows/update-all.sh"
HISTORY_SCRIPT="$FORGE_DIR/lib/results/history.py"
SELF_UPDATE_SCRIPT="$FORGE_DIR/lib/self-update.sh"

[[ -r "$CONFIG_GET_SCRIPT" ]] || fail "config get helper is not readable: $CONFIG_GET_SCRIPT"
# shellcheck source=/dev/null
source "$CONFIG_GET_SCRIPT" || fail "could not load config helpers"

write_runtime_state() {
  local key
  local -a keys=()

  mapfile -t keys < <(printf '%s\n' "${!CONFIG[@]}" | LC_ALL=C sort)

  {
    printf 'meta\tpid\t%s\n' "$$"
    printf 'meta\trun_id\t%s\n' "$run_id"
    printf 'meta\tcommand\t%s\n' "$command_name"
    for key in "${keys[@]}"; do
      printf 'config\t%s\t%s\n' "$key" "${CONFIG[$key]}"
    done
  } > "$LOCK_FILE" || fail "could not record effective Forge run state"
}

ensure_lxc_environment() {
  [[ "${FORGE_LXC_ENVIRONMENT_READY:-}" == "$run_id" ]] && return 0
  [[ -r "$LXC_ENVIRONMENT_SCRIPT" ]] || fail "LXC environment helper is not readable: $LXC_ENVIRONMENT_SCRIPT"
  bash "$LXC_ENVIRONMENT_SCRIPT" >/dev/null || fail "LXC environment check failed"
  export FORGE_LXC_ENVIRONMENT_READY="$run_id"
}

case "${1:-}" in
  validate-config|show-config|status|history|host|lxc)
    config_get_files "$CONFIG_FILE" "$LOCAL_CONFIG_FILE" || exit 1
    export FORGE_LANGUAGE="${CONFIG[LANGUAGE]}"
    write_runtime_state
    export FORGE_RUNTIME_CONFIG_READY=true
    ;;
  help|-h|--help|'')
    # Keep help available in English even if local config is invalid.
    if config_get_files "$CONFIG_FILE" "$LOCAL_CONFIG_FILE" >/dev/null 2>&1; then
      export FORGE_LANGUAGE="${CONFIG[LANGUAGE]}"
    fi
    ;;
esac

# F238: load normal update configuration, but do not require it for an
# explicit self-update: a self-update may need to repair invalid defaults.
if [[ "${1:-}" == update ]]; then
  config_get_files "$CONFIG_FILE" "$LOCAL_CONFIG_FILE" || exit 1
  export FORGE_LANGUAGE="${CONFIG[LANGUAGE]}"
  write_runtime_state
  export FORGE_RUNTIME_CONFIG_READY=true
fi

# This opt-in prompt runs only before manual updates, never inside a
# mutating stage or scheduled execution. The global lock is already held.
offer_self_update() {
  local check_result answer
  [[ "${CONFIG[CHECK_FORGE_UPDATES_BEFORE_UPDATE]:-false}" == true ]] || return 0
  [[ "${FORGE_SELF_UPDATE_SKIP_PROMPT:-}" != 1 ]] || return 0
  if [[ ! -t 0 || ! -t 1 || ! -r /dev/tty ]]; then
    printf 'NOTICE: Forge version prompt skipped (no interactive terminal)\n' >&2
    return 0
  fi
  if [[ ! -r "$SELF_UPDATE_SCRIPT" ]]; then
    printf 'WARNING: cannot check Forge updates: self-update helper is missing\n' >&2
    return 0
  fi
  check_result="$(bash "$SELF_UPDATE_SCRIPT" check "$FORGE_DIR" main)" || {
    printf 'WARNING: Forge version check failed; continuing with installed version\n' >&2
    return 0
  }
  [[ "$check_result" == self_update=available\ * ]] || return 0
  forge_tr cli.prompt.available
  printf '%s\n' "$check_result"
  while :; do
    printf '%s ' "$(forge_tr cli.prompt.question)"
    if ! IFS= read -r answer </dev/tty; then
      printf '\n%s\n' "$(forge_tr cli.prompt.interrupted)" >&2
      return 1
    fi
    case "$answer" in
      y|Y|yes|YES|s|S|si|SI|sí|SÍ)
        bash "$SELF_UPDATE_SCRIPT" update "$FORGE_DIR" main || {
          forge_tr cli.prompt.failed >&2
          return 1
        }
        forge_tr cli.prompt.restarting
        # The new CLI must acquire the global lock before any new mutation.
        # The old shell is replaced; its exit trap is not run.
        export FORGE_SELF_UPDATE_SKIP_PROMPT=1 FORGE_SELF_UPDATE_REEXEC=1
        exec "$FORGE_ENTRYPOINT" "$@"
        ;;
      n|N|no|NO|'') return 0 ;;
      c|C|cancel|CANCEL|cancelar|CANCELAR) forge_tr cli.prompt.cancelled; return 1 ;;
      *) forge_tr cli.prompt.invalid ;;
    esac
  done
}

case "${1:-}:${2:-}" in
  host:update|lxc:update|update:all)
    offer_self_update "$@" || exit 1
    ;;
esac

# F131: only manual updates opt into persistent mode. The actual update,
# self-update prompt and run log retain their existing behaviour; only the
# interactive terminal is moved into tmux outside the SSH login scope.
if [[ "${FORGE_PERSISTENT_INNER:-}" != 1 ]]; then
  case "${1:-}:${2:-}" in
    host:update|lxc:update|update:all)
      if [[ "${CONFIG[PERSISTENT_UPDATE_SESSION]}" == true ]]; then
        forge_persistent_prepare || exit 1
      if ! forge_persistent_spawn "$FORGE_ENTRYPOINT" "$@"; then
        exit 1
      fi
      # The outer CLI must not retain flock while attached, or the tmux
      # worker would be blocked. The real worker takes a fresh flock itself.
      : > "$LOCK_FILE" || fail "could not release Forge launcher state"
      trap - EXIT
      flock -u "$LOCK_FD" || {
        printf 'ERROR: could not hand off the Forge update lock\n' >&2
        exit 1
      }
      exec 200>&-
      unset FORGE_CONTEXT FORGE_RUN_ID FORGE_LOCK_FILE FORGE_LOCK_FD
      unset FORGE_RUNTIME_GUARD FORGE_RUNTIME_CONFIG_READY
        forge_persistent_attach
        exit $?
      fi
      ;;
  esac
fi

# F141: open one run log only for update commands, after validated configuration
# is loaded but before any update preflight or mutation. Utility commands do not
# create execution logs.
case "${1:-}:${2:-}" in
  host:update|lxc:update|update:all|update:scheduled)
    run_log_init="$FORGE_DIR/lib/logging/init.sh"
    run_log_write="$FORGE_DIR/lib/logging/write.sh"
    [[ -r "$run_log_init" && -r "$run_log_write" ]] || fail "run logging helpers are unavailable"
    run_log="$(bash "$run_log_init" "${CONFIG[LOG_DIR]}" "${CONFIG[LOG_KEEP]}" run "$run_id")" || \
      fail "could not initialize general log for Forge run"
    export FORGE_RUN_LOG="$run_log"
    run_started_epoch="$(date +%s)" || fail "could not measure Forge run start"
    bash "$run_log_write" "$run_log" INFO run_start \
      "run_id=$run_id" "command=$command_name" || fail "could not record Forge run start"
    ;;
esac

# Compact presentation is a read-only stdout/stderr consumer. Raw workflows and
# their logs remain authoritative; non-TTY and scheduled runs stay unchanged.
run_with_progress() {
  local view="$1" target="$2"
  shift 2
  local presenter="$FORGE_DIR/lib/ui/progress.py"
  local -a statuses=()

  if [[ -t 1 && "${FORGE_OUTPUT_MODE:-compact}" != full ]]; then
    [[ -r "$presenter" ]] || fail "compact presenter is not readable: $presenter"
    command -v python3 >/dev/null 2>&1 || fail "Python 3 is required for compact output"
    "$@" 2>&1 | python3 -u "$presenter" "$view" "$target"
    statuses=("${PIPESTATUS[@]}")
    if (( statuses[1] != 0 )); then
      printf 'ERROR: Forge compact output failed (exit %s); inspect the run log\n' "${statuses[1]}" >&2
      # Preserve the original updater failure code whenever there was one.
      (( statuses[0] != 0 )) && return "${statuses[0]}"
      return "${statuses[1]}"
    fi
    return "${statuses[0]}"
  fi
  "$@"
}

run_update_all() {
  local mode="$1"

  [[ -r "$UPDATE_ALL_SCRIPT" ]] || fail "update coordinator is not readable: $UPDATE_ALL_SCRIPT"
  if [[ "$mode" == scheduled ]]; then
    [[ "${CONFIG[SCHEDULED_UPDATE_HOST]}" == true || -n "${CONFIG[SCHEDULED_UPDATE_LXC]}" ]] ||
      fail "scheduled updates have no authorized targets"
    export FORGE_SCHEDULED_MODE=scheduled
    [[ -z "${CONFIG[SCHEDULED_UPDATE_LXC]}" ]] || ensure_lxc_environment
  elif [[ "${CONFIG[UPDATE_RUNNING_LXC]}" == true ]]; then
    ensure_lxc_environment
  fi
  if [[ "$mode" == scheduled ]]; then
    bash "$UPDATE_ALL_SCRIPT" "$mode"
  else
    run_with_progress bulk "$mode" bash "$UPDATE_ALL_SCRIPT" "$mode"
  fi
}

# F228: read the retained logs only; neither query creates a log nor invokes a target.
# Global CLI locking is preserved until F131 introduces independent jobs.
run_history() {
  local mode="$1" fqdn
  shift
  [[ -r "$HISTORY_SCRIPT" ]] || fail "history renderer is not readable: $HISTORY_SCRIPT"
  command -v python3 >/dev/null 2>&1 || fail "Python 3 is required for history queries"
  fqdn="$(hostname -f)" || fail "could not determine Proxmox host FQDN"
  python3 "$HISTORY_SCRIPT" "$mode" "${CONFIG[LOG_DIR]}" "$fqdn" "$@"
}

# Check the exact LXC scope before any mutation; config values were already validated.
check_lxc_conflicts() {
  [[ -r "$LXC_CONFLICTS_SCRIPT" ]] || fail "LXC conflict checker is not readable"
  bash "$LXC_CONFLICTS_SCRIPT" "$@" || \
    fail "LXC protection conflicts detected; no updates started"
  export FORGE_LXC_BACKUP_PREFLIGHT_OK=true
}

# validate-config reports conflicts only for the running LXCs in bulk scope.
check_running_lxc_conflicts() {
  local records line
  local -a selected=()

  [[ "${CONFIG[UPDATE_RUNNING_LXC]}" == true ]] || return 0
  ensure_lxc_environment
  records="$(bash "$LXC_LIST_TARGETS_SCRIPT" true "${CONFIG[EXCLUDE]}")" || fail "could not select running LXCs"
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    [[ "$line" =~ (^|[[:space:]])vmid=([0-9]+) ]] || fail "invalid target record: $line"
    selected+=("${BASH_REMATCH[2]}")
  done <<<"$records"
  check_lxc_conflicts "${selected[@]}"
}

main() {
  local command="${1:-}" target_record

  case "$command" in
    validate-config)
      [[ $# -eq 1 ]] || fail "validate-config does not accept additional arguments"
      check_running_lxc_conflicts
      if [[ -f "$LOCAL_CONFIG_FILE" ]]; then
        forge_tr cli.config_ok "defaults=$CONFIG_FILE" "overrides=$LOCAL_CONFIG_FILE"
      else
        forge_tr cli.config_ok "defaults=$CONFIG_FILE" "overrides=$(forge_tr cli.no_overrides)"
      fi
      ;;
    show-config)
      [[ $# -eq 1 ]] || fail "show-config does not accept additional arguments"
      [[ -r "$CONFIG_SHOW_SCRIPT" ]] || fail "config show helper is not readable: $CONFIG_SHOW_SCRIPT"
      # shellcheck source=/dev/null
      source "$CONFIG_SHOW_SCRIPT" || fail "could not load config show helper"
      config_show || fail "could not show effective Forge configuration"
      ;;
    status)
      [[ $# -eq 1 || ( $# -eq 2 && "$2" == --json ) ]] || fail "usage: forge status [--json]"
      run_history status "${@:2}"
      ;;
    history)
      [[ $# -ge 1 && $# -le 3 ]] || fail "usage: forge history [RUN_ID] [--json]"
      run_history history "${@:2}"
      ;;
    host)
      [[ $# -eq 2 && "$2" == update ]] || fail "usage: forge host update"
      [[ -r "$HOST_UPDATE_SCRIPT" ]] || fail "host update workflow is not readable: $HOST_UPDATE_SCRIPT"
      run_with_progress host HOST bash "$HOST_UPDATE_SCRIPT"
      ;;
    lxc)
      case "${2:-}" in
        list-targets)
          [[ $# -eq 2 ]] || fail "usage: forge lxc list-targets"
          [[ -r "$LXC_LIST_TARGETS_SCRIPT" ]] || fail "LXC target-list helper is not readable: $LXC_LIST_TARGETS_SCRIPT"
          if [[ "${CONFIG[UPDATE_RUNNING_LXC]}" == true ]]; then
            ensure_lxc_environment
          fi
          bash "$LXC_LIST_TARGETS_SCRIPT" "${CONFIG[UPDATE_RUNNING_LXC]}" "${CONFIG[EXCLUDE]}"
          ;;
        update)
          [[ $# -ge 3 ]] || fail "usage: forge lxc update TARGET [TARGET...]|all"
          if [[ "$3" == all ]]; then
            [[ $# -eq 3 ]] || fail "'all' cannot be combined with explicit LXC targets"
            run_update_all lxc
          elif [[ $# -eq 3 ]]; then
            [[ -r "$LXC_UPDATE_SCRIPT" ]] || fail "LXC update workflow is not readable: $LXC_UPDATE_SCRIPT"
            ensure_lxc_environment
            target_record="$(bash "$LXC_GET_TARGET_SCRIPT" "$3")" || fail "could not resolve LXC target"
            [[ "$target_record" =~ (^|[[:space:]])vmid=([0-9]+) ]] || fail "invalid target record"
            check_lxc_conflicts "${BASH_REMATCH[2]}"
            run_with_progress lxc "$3" bash "$LXC_UPDATE_SCRIPT" "$3"
          else
            # F247: resolve the entire explicit set before any mutation. Keep
            # single-target and automatic 'all' semantics unchanged.
            [[ -r "$UPDATE_ALL_SCRIPT" ]] || fail "update coordinator is not readable: $UPDATE_ALL_SCRIPT"
            ensure_lxc_environment
            local target vmid
            local -a selected_ids=()
            local -A seen_ids=()
            for target in "${@:3}"; do
              [[ "$target" != all ]] || fail "'all' cannot be combined with explicit LXC targets"
              target_record="$(bash "$LXC_GET_TARGET_SCRIPT" "$target")" ||
                fail "could not resolve LXC target '$target'; no updates started"
              [[ "$target_record" =~ (^|[[:space:]])vmid=([0-9]+) ]] ||
                fail "invalid target record for '$target'"
              vmid="${BASH_REMATCH[2]}"
              [[ "$target_record" =~ (^|[[:space:]])template=false($|[[:space:]]) ]] ||
                fail "LXC $vmid is a template and cannot be updated"
              [[ -z "${seen_ids[$vmid]+x}" ]] ||
                fail "LXC $vmid was selected more than once; no updates started"
              seen_ids[$vmid]=true
              selected_ids+=("$vmid")
            done
            run_with_progress bulk selected bash "$UPDATE_ALL_SCRIPT" selected "${selected_ids[@]}"
          fi
          ;;
        *)
          fail "usage: forge lxc list-targets | forge lxc update TARGET [TARGET...]|all"
          ;;
      esac
      ;;
    self-update)
      [[ $# -eq 1 || $# -eq 2 ]] || fail "usage: forge self-update [BRANCH]"
      [[ -r "$SELF_UPDATE_SCRIPT" ]] || fail "self-update helper is not readable"
      bash "$SELF_UPDATE_SCRIPT" update "$FORGE_DIR" "${2:-main}"
      ;;
    update)
      [[ $# -eq 2 && ( "$2" == all || "$2" == scheduled ) ]] ||
        fail "usage: forge update all|scheduled"
      run_update_all "$2"
      ;;
    help|-h|--help)
      [[ -r "$HELP_SCRIPT" ]] || fail "CLI help script is not readable: $HELP_SCRIPT"
      bash "$HELP_SCRIPT"
      ;;
    '')
      [[ -r "$HELP_SCRIPT" ]] || fail "CLI help script is not readable: $HELP_SCRIPT"
      bash "$HELP_SCRIPT"
      exit 1
      ;;
    *)
      fail "unknown command '$command'"
      ;;
  esac
}

main "$@"
