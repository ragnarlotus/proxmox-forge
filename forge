#!/bin/bash
# Description: Main Forge CLI orchestrator. Validates configuration and dispatches commands to specialized scripts without implementing domain logic.

set -u

CONFIG_FILE="/etc/proxmox-forge/forge.conf"

fail() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

FORGE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)" || fail "could not determine Forge directory"
CONFIG_GET_SCRIPT="$FORGE_DIR/lib/config/get.sh"
LXC_TARGET_SCRIPT="$FORGE_DIR/lib/lxc/get-target.sh"
LXC_LIST_TARGETS_SCRIPT="$FORGE_DIR/lib/lxc/list-targets.sh"
LXC_GET_INFO_SCRIPT="$FORGE_DIR/lib/lxc/get-info.sh"
CHECK_REQUIREMENTS_SCRIPT="$FORGE_DIR/lib/workflows/check-requirements.sh"

[[ -r "$CONFIG_GET_SCRIPT" ]] || fail "config get helper is not readable: $CONFIG_GET_SCRIPT"
# shellcheck source=/dev/null
source "$CONFIG_GET_SCRIPT" || fail "could not load config helpers"

usage() {
  cat <<'EOF'
Usage: forge COMMAND [ARGUMENTS]

Commands:
  validate-config             Load and validate the complete Forge configuration.
  resolve-target TARGET       Resolve one local LXC by exact VMID or exact name.
  list-lxc-targets            List LXC targets enabled by the current Forge scope.
  inspect-target TARGET       Read the complete available information for one running LXC.
  check-requirements TARGET   Check whether one LXC satisfies current update requirements.
  help                        Show this help.
EOF
}

main() {
  local command="${1:-}"

  case "$command" in
    validate-config)
      [[ $# -eq 1 ]] || fail "validate-config does not accept additional arguments"
      config_get "$CONFIG_FILE" || exit 1
      printf 'Forge configuration OK: %s\n' "$CONFIG_FILE"
      ;;
    resolve-target)
      [[ $# -eq 2 ]] || fail "resolve-target requires exactly one VMID or name"
      config_get "$CONFIG_FILE" || exit 1
      [[ -r "$LXC_TARGET_SCRIPT" ]] || fail "LXC target helper is not readable: $LXC_TARGET_SCRIPT"
      bash "$LXC_TARGET_SCRIPT" "$2"
      ;;
    list-lxc-targets)
      [[ $# -eq 1 ]] || fail "list-lxc-targets does not accept additional arguments"
      config_get "$CONFIG_FILE" || exit 1
      [[ -r "$LXC_LIST_TARGETS_SCRIPT" ]] || fail "LXC target-list helper is not readable: $LXC_LIST_TARGETS_SCRIPT"
      bash "$LXC_LIST_TARGETS_SCRIPT" \
        "${CONFIG[UPDATE_LXC]}" \
        "${CONFIG[UPDATE_RUNNING_LXC]}" \
        "${CONFIG[UPDATE_STOPPED_LXC]}"
      ;;
    inspect-target)
      [[ $# -eq 2 ]] || fail "inspect-target requires exactly one VMID or name"
      config_get "$CONFIG_FILE" || exit 1
      [[ -r "$LXC_GET_INFO_SCRIPT" ]] || fail "LXC information helper is not readable: $LXC_GET_INFO_SCRIPT"
      bash "$LXC_GET_INFO_SCRIPT" "$2" "${CONFIG[CUSTOM_SCRIPTS_DIR]}"
      ;;
    check-requirements)
      [[ $# -eq 2 ]] || fail "check-requirements requires exactly one VMID or name"
      config_get "$CONFIG_FILE" || exit 1
      [[ -r "$CHECK_REQUIREMENTS_SCRIPT" ]] || fail "requirements workflow is not readable: $CHECK_REQUIREMENTS_SCRIPT"
      bash "$CHECK_REQUIREMENTS_SCRIPT" "$2" "${CONFIG[CUSTOM_SCRIPTS_DIR]}"
      ;;
    help|-h|--help)
      usage
      ;;
    '')
      usage
      exit 1
      ;;
    *)
      fail "unknown command '$command'"
      ;;
  esac
}

main "$@"
