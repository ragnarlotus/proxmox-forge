#!/bin/bash
# Description: Main Forge CLI orchestrator. Loads shared orchestration helpers and dispatches commands without implementing domain logic.

set -u

FORGE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)" || {
  printf 'ERROR: could not determine Forge directory\n' >&2
  exit 1
}

CONFIG_FILE="$FORGE_DIR/forge.conf.default"
LOCAL_CONFIG_FILE="$FORGE_DIR/forge.conf"

FAIL_SCRIPT="$FORGE_DIR/lib/helpers/fail.sh"
HELP_SCRIPT="$FORGE_DIR/lib/cli/help.sh"
CONFIG_GET_SCRIPT="$FORGE_DIR/lib/config/get.sh"
LOCKING_SCRIPT="$FORGE_DIR/lib/runtime/locking.sh"
MUTATION_GUARD_SCRIPT="$FORGE_DIR/lib/runtime/require-mutation-context.sh"
HOST_REQUIREMENTS_SCRIPT="$FORGE_DIR/lib/host/check-requirements.sh"
HOST_UPDATE_SCRIPT="$FORGE_DIR/lib/host/update.sh"
LXC_LIST_TARGETS_SCRIPT="$FORGE_DIR/lib/lxc/list-targets.sh"
LXC_GET_INFO_SCRIPT="$FORGE_DIR/lib/lxc/get-info.sh"
LXC_UPDATE_SCRIPT="$FORGE_DIR/lib/lxc/update.sh"
UPDATE_ALL_SCRIPT="$FORGE_DIR/lib/workflows/update-all.sh"
CHECK_REQUIREMENTS_SCRIPT="$FORGE_DIR/lib/workflows/check-requirements.sh"

[[ -r "$FAIL_SCRIPT" ]] || {
  printf 'ERROR: failure helper is not readable: %s\n' "$FAIL_SCRIPT" >&2
  exit 1
}
# shellcheck source=/dev/null
source "$FAIL_SCRIPT"

[[ -r "$CONFIG_GET_SCRIPT" ]] || fail "config get helper is not readable: $CONFIG_GET_SCRIPT"
# shellcheck source=/dev/null
source "$CONFIG_GET_SCRIPT" || fail "could not load config helpers"

[[ -r "$LOCKING_SCRIPT" ]] || fail "runtime locking helper is not readable: $LOCKING_SCRIPT"
[[ -r "$MUTATION_GUARD_SCRIPT" ]] || fail "mutation context guard is not readable: $MUTATION_GUARD_SCRIPT"
# shellcheck source=/dev/null
source "$LOCKING_SCRIPT" || fail "could not load runtime locking helper"

begin_mutation() {
  local description="$1"

  export FORGE_RUNTIME_GUARD="$MUTATION_GUARD_SCRIPT"
  forge_acquire_mutation_lock "$description" || exit 1
}

main() {
  local command="${1:-}"

  case "$command" in
    validate-config)
      [[ $# -eq 1 ]] || fail "validate-config does not accept additional arguments"
      config_get "$CONFIG_FILE" "$LOCAL_CONFIG_FILE" || exit 1
      if [[ -f "$LOCAL_CONFIG_FILE" ]]; then
        printf 'Forge configuration OK: defaults=%s overrides=%s\n' "$CONFIG_FILE" "$LOCAL_CONFIG_FILE"
      else
        printf 'Forge configuration OK: defaults=%s overrides=none\n' "$CONFIG_FILE"
      fi
      ;;
    check-host-requirements)
      [[ $# -eq 1 ]] || fail "check-host-requirements does not accept additional arguments"
      config_get "$CONFIG_FILE" "$LOCAL_CONFIG_FILE" || exit 1
      [[ -r "$HOST_REQUIREMENTS_SCRIPT" ]] || fail "host requirements workflow is not readable: $HOST_REQUIREMENTS_SCRIPT"
      bash "$HOST_REQUIREMENTS_SCRIPT"
      ;;
    update-host)
      [[ $# -eq 1 ]] || fail "update-host does not accept additional arguments"
      begin_mutation "update-host"
      [[ -r "$HOST_UPDATE_SCRIPT" ]] || fail "host update workflow is not readable: $HOST_UPDATE_SCRIPT"
      bash "$HOST_UPDATE_SCRIPT" "$CONFIG_FILE"
      ;;
    list-lxc-targets)
      [[ $# -eq 1 ]] || fail "list-lxc-targets does not accept additional arguments"
      config_get "$CONFIG_FILE" "$LOCAL_CONFIG_FILE" || exit 1
      [[ -r "$LXC_LIST_TARGETS_SCRIPT" ]] || fail "LXC target-list helper is not readable: $LXC_LIST_TARGETS_SCRIPT"
      bash "$LXC_LIST_TARGETS_SCRIPT" \
        "${CONFIG[UPDATE_LXC]}" \
        "${CONFIG[UPDATE_RUNNING_LXC]}" \
        "${CONFIG[UPDATE_STOPPED_LXC]}"
      ;;
    inspect-target)
      [[ $# -eq 2 ]] || fail "inspect-target requires exactly one VMID or name"
      config_get "$CONFIG_FILE" "$LOCAL_CONFIG_FILE" || exit 1
      [[ -r "$LXC_GET_INFO_SCRIPT" ]] || fail "LXC information helper is not readable: $LXC_GET_INFO_SCRIPT"
      bash "$LXC_GET_INFO_SCRIPT" "$2" "${CONFIG[CUSTOM_SCRIPTS_DIR]}"
      ;;
    check-requirements)
      [[ $# -eq 2 ]] || fail "check-requirements requires exactly one VMID or name"
      config_get "$CONFIG_FILE" "$LOCAL_CONFIG_FILE" || exit 1
      [[ -r "$CHECK_REQUIREMENTS_SCRIPT" ]] || fail "requirements workflow is not readable: $CHECK_REQUIREMENTS_SCRIPT"
      bash "$CHECK_REQUIREMENTS_SCRIPT" "$2" "${CONFIG[CUSTOM_SCRIPTS_DIR]}"
      ;;
    update)
      [[ $# -eq 2 ]] || fail "update requires exactly one VMID or name"
      begin_mutation "update $2"
      [[ -r "$LXC_UPDATE_SCRIPT" ]] || fail "LXC update workflow is not readable: $LXC_UPDATE_SCRIPT"
      bash "$LXC_UPDATE_SCRIPT" "$2" "$CONFIG_FILE"
      ;;
    update-all)
      [[ $# -eq 1 ]] || fail "update-all does not accept additional arguments"
      begin_mutation "update-all"
      [[ -r "$UPDATE_ALL_SCRIPT" ]] || fail "global update coordinator is not readable: $UPDATE_ALL_SCRIPT"
      bash "$UPDATE_ALL_SCRIPT" "$CONFIG_FILE"
      ;;
    help|-h|--help)
      [[ -r "$HELP_SCRIPT" ]] || fail "CLI help script is not readable: $HELP_SCRIPT"
      bash "$HELP_SCRIPT"
      ;;
    '')
      [[ -r "$HELP_SCRIPT" ]] || fail "CLI help script is not readable: $HELP_SCRIPT"
      bash "$HELP_SCRIPT"
      exit 1
      ;;
    *)
      fail "unknown command '$command'"
      ;;
  esac
}

main "$@"
