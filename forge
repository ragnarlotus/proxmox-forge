#!/bin/bash
# Description: Main Forge CLI orchestrator. Dispatches commands and coordinates specialized scripts while keeping domain logic out of the entry point.

set -u

CONFIG_FILE="/etc/proxmox-forge/forge.conf"

fail() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

FORGE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)" || fail "could not determine Forge directory"
LXC_DIR="$FORGE_DIR/lib/lxc"
CONFIG_DIR="$FORGE_DIR/lib/config"
CONFIG_GET_SCRIPT="$CONFIG_DIR/get.sh"

[[ -r "$CONFIG_GET_SCRIPT" ]] || fail "config get helper is not readable: $CONFIG_GET_SCRIPT"
# shellcheck source=/dev/null
source "$CONFIG_GET_SCRIPT"

field_value() {
  local record="$1" wanted="$2" field

  for field in $record; do
    if [[ "$field" == "$wanted="* ]]; then
      printf '%s' "${field#*=}"
      return 0
    fi
  done

  return 1
}

list_lxc_targets() {
  local config_file vmid target_record name state template
  local environment_script="$LXC_DIR/get-environment.sh"
  local target_script="$LXC_DIR/get-target.sh"
  local -a config_files=()

  [[ "${CONFIG[UPDATE_LXC]}" == true ]] || return 0
  [[ -r "$environment_script" ]] || fail "LXC environment helper is not readable: $environment_script"
  [[ -r "$target_script" ]] || fail "LXC target helper is not readable: $target_script"

  bash "$environment_script" >/dev/null || fail "LXC environment check failed"

  shopt -s nullglob
  config_files=(/etc/pve/lxc/*.conf)
  shopt -u nullglob

  for config_file in "${config_files[@]}"; do
    vmid="${config_file##*/}"
    vmid="${vmid%.conf}"

    target_record="$(bash "$target_script" "$vmid")" || fail "could not read LXC target $vmid"
    name="$(field_value "$target_record" name)" || fail "LXC target helper returned no name"
    state="$(field_value "$target_record" state)" || fail "LXC target helper returned no state"
    template="$(field_value "$target_record" template)" || fail "LXC target helper returned no template field"

    [[ "$template" == true ]] && continue

    case "$state" in
      running)
        [[ "${CONFIG[UPDATE_RUNNING_LXC]}" == true ]] || continue
        ;;
      stopped)
        [[ "${CONFIG[UPDATE_STOPPED_LXC]}" == true ]] || continue
        ;;
      *)
        fail "LXC $vmid returned unsupported state '$state'"
        ;;
    esac

    printf 'type=lxc vmid=%s name=%s state=%s template=false\n' \
      "$vmid" "$name" "$state"
  done
}

inspect_lxc_target() {
  local target="$1" target_record vmid name state template custom_script=false
  local target_script="$LXC_DIR/get-target.sh"
  local so_script="$LXC_DIR/get-so-info.sh"
  local package_script="$LXC_DIR/get-package-manager.sh"
  local updater_script="$LXC_DIR/get-application-updater.sh"
  local so_record package_record updater_record
  local os_id os_version package_manager application_updater

  for helper in "$target_script" "$so_script" "$package_script" "$updater_script"; do
    [[ -r "$helper" ]] || fail "LXC helper is not readable: $helper"
  done

  target_record="$(bash "$target_script" "$target")" || fail "could not resolve LXC target '$target'"
  vmid="$(field_value "$target_record" vmid)" || fail "LXC target helper returned no vmid"
  name="$(field_value "$target_record" name)" || fail "LXC target helper returned no name"
  state="$(field_value "$target_record" state)" || fail "LXC target helper returned no state"
  template="$(field_value "$target_record" template)" || fail "LXC target helper returned no template field"

  [[ "$template" == false ]] || fail "LXC $vmid ($name) is a template and cannot be inspected as an update target"
  [[ "$state" == running ]] || fail "LXC $vmid ($name) is $state; read-only guest inspection requires a running container"

  so_record="$(bash "$so_script" "$vmid")" || fail "could not read OS information for LXC $vmid ($name)"
  package_record="$(bash "$package_script" "$vmid")" || fail "could not read package-manager information for LXC $vmid ($name)"
  updater_record="$(bash "$updater_script" "$vmid")" || fail "could not read application-updater information for LXC $vmid ($name)"

  os_id="$(field_value "$so_record" os_id)" || fail "OS helper returned no os_id"
  os_version="$(field_value "$so_record" os_version)" || fail "OS helper returned no os_version"
  package_manager="$(field_value "$package_record" package_manager)" || fail "package-manager helper returned no package_manager"
  application_updater="$(field_value "$updater_record" application_updater)" || fail "application-updater helper returned no application_updater"

  if [[ -d "${CONFIG[CUSTOM_SCRIPTS_DIR]}/$vmid" ]] &&
     find "${CONFIG[CUSTOM_SCRIPTS_DIR]}/$vmid" -maxdepth 1 -type f -print -quit 2>/dev/null | grep -q .; then
    custom_script=true
  fi

  printf 'type=lxc vmid=%s name=%s state=%s template=false os_id=%s os_version=%s package_manager=%s application_updater=%s custom_script=%s\n' \
    "$vmid" "$name" "$state" "$os_id" "$os_version" "$package_manager" "$application_updater" "$custom_script"
}

plan_lxc_target() {
  local target="$1" inspection vmid name state package_manager application_updater custom_script

  [[ "${CONFIG[UPDATE_LXC]}" == true ]] || fail "LXC updates are disabled by UPDATE_LXC=false"

  inspection="$(inspect_lxc_target "$target")"
  vmid="$(field_value "$inspection" vmid)" || fail "inspection did not return vmid"
  name="$(field_value "$inspection" name)" || fail "inspection did not return name"
  state="$(field_value "$inspection" state)" || fail "inspection did not return state"
  package_manager="$(field_value "$inspection" package_manager)" || fail "inspection did not return package_manager"
  application_updater="$(field_value "$inspection" application_updater)" || fail "inspection did not return application_updater"
  custom_script="$(field_value "$inspection" custom_script)" || fail "inspection did not return custom_script"

  case "$state" in
    running)
      [[ "${CONFIG[UPDATE_RUNNING_LXC]}" == true ]] || \
        fail "LXC $vmid ($name) is running but UPDATE_RUNNING_LXC=false"
      ;;
    stopped)
      [[ "${CONFIG[UPDATE_STOPPED_LXC]}" == true ]] || \
        fail "LXC $vmid ($name) is stopped and UPDATE_STOPPED_LXC=false"
      ;;
  esac

  if [[ "${CONFIG[UPDATE_LXC_OS]}" == true && "$package_manager" == unknown ]]; then
    fail "LXC $vmid ($name) has no supported package manager for the requested OS update"
  fi

  printf 'target type=lxc vmid=%s name=%s state=%s\n' "$vmid" "$name" "$state"
  printf 'stage=preflight enabled=%s\n' "${CONFIG[PREFLIGHT]}"
  printf 'stage=protection enabled=%s source=proxmox-policy\n' "${CONFIG[PROTECTION]}"
  printf 'stage=os_update enabled=%s adapter=%s\n' "${CONFIG[UPDATE_LXC_OS]}" "$package_manager"

  if [[ "${CONFIG[UPDATE_LXC_APPLICATION]}" == true && "$application_updater" != none ]]; then
    printf 'stage=application_update enabled=true updater=%s\n' "$application_updater"
  else
    printf 'stage=application_update enabled=false updater=%s\n' "$application_updater"
  fi

  if [[ "${CONFIG[RUN_CUSTOM_SCRIPTS]}" == true && "$custom_script" == true ]]; then
    printf 'stage=custom_scripts enabled=true path=%s/%s\n' "${CONFIG[CUSTOM_SCRIPTS_DIR]}" "$vmid"
  else
    printf 'stage=custom_scripts enabled=false path=%s/%s\n' "${CONFIG[CUSTOM_SCRIPTS_DIR]}" "$vmid"
  fi

  printf 'stage=health_check enabled=%s\n' "${CONFIG[HEALTH_CHECK]}"
  printf 'rollback_on_failure=%s\n' "${CONFIG[ROLLBACK_ON_FAILURE]}"
}

protect_lxc_target() {
  local target="$1" dry_run="$2"
  local target_record vmid name state template
  local target_script="$LXC_DIR/get-target.sh"
  local preflight_script="$LXC_DIR/preflight.sh"
  local backup_script="$FORGE_DIR/lib/backup/create.sh"

  [[ "${CONFIG[UPDATE_LXC]}" == true ]] || fail "LXC updates are disabled by UPDATE_LXC=false"
  [[ -r "$target_script" ]] || fail "LXC target helper is not readable: $target_script"

  target_record="$(bash "$target_script" "$target")" || fail "could not resolve LXC target '$target'"
  vmid="$(field_value "$target_record" vmid)" || fail "LXC target helper returned no vmid"
  name="$(field_value "$target_record" name)" || fail "LXC target helper returned no name"
  state="$(field_value "$target_record" state)" || fail "LXC target helper returned no state"
  template="$(field_value "$target_record" template)" || fail "LXC target helper returned no template field"

  [[ "$template" == false ]] || fail "LXC $vmid ($name) is a template and cannot be protected as an update target"

  case "$state" in
    running)
      [[ "${CONFIG[UPDATE_RUNNING_LXC]}" == true ]] || \
        fail "LXC $vmid ($name) is running but UPDATE_RUNNING_LXC=false"
      ;;
    stopped)
      [[ "${CONFIG[UPDATE_STOPPED_LXC]}" == true ]] || \
        fail "LXC $vmid ($name) is stopped and UPDATE_STOPPED_LXC=false"
      ;;
  esac

  if [[ "${CONFIG[PREFLIGHT]}" == true ]]; then
    [[ -r "$preflight_script" ]] || fail "LXC preflight helper is not readable: $preflight_script"
    printf 'stage=preflight vmid=%s\n' "$vmid"
    bash "$preflight_script" "$vmid" || fail "preflight failed for LXC $vmid ($name)"
  else
    printf 'stage=preflight skipped vmid=%s\n' "$vmid"
  fi

  if [[ "${CONFIG[PROTECTION]}" == true ]]; then
    [[ -r "$backup_script" ]] || fail "backup create helper is not readable: $backup_script"
    printf 'stage=protection vmid=%s dry_run=%s\n' "$vmid" "$dry_run"
    if [[ "$dry_run" == true ]]; then
      bash "$backup_script" "$vmid" --dry-run || fail "backup protection dry-run failed for LXC $vmid ($name)"
    else
      bash "$backup_script" "$vmid" || fail "backup protection failed for LXC $vmid ($name)"
    fi
  else
    printf 'stage=protection skipped vmid=%s\n' "$vmid"
  fi

  printf 'protect-target=ok vmid=%s dry_run=%s\n' "$vmid" "$dry_run"
}

usage() {
  cat <<'EOF'
Usage: forge COMMAND [ARGUMENTS]

Commands:
  validate-config        Load and validate the complete Forge configuration.
  resolve-target TARGET  Resolve one local LXC by exact VMID or exact name.
  list-lxc-targets       List LXC targets enabled by the current Forge scope.
  inspect-target TARGET  Read OS/updater capabilities from one running LXC.
  plan-target TARGET     Build the read-only update plan for one running LXC.
  protect-target TARGET [--dry-run]
                         Run preflight and Proxmox backup protection for one LXC.
  help                   Show this help.
EOF
}

main() {
  local command="${1:-}"

  case "$command" in
    validate-config)
      [[ $# -eq 1 ]] || fail "validate-config does not accept additional arguments"
      config_get "$CONFIG_FILE" || exit 1
      printf 'Forge configuration OK: %s\n' "$CONFIG_FILE"
      ;;
    resolve-target)
      [[ $# -eq 2 ]] || fail "resolve-target requires exactly one VMID or name"
      config_get "$CONFIG_FILE" || exit 1
      [[ -r "$LXC_DIR/get-target.sh" ]] || fail "LXC target helper is not readable: $LXC_DIR/get-target.sh"
      bash "$LXC_DIR/get-target.sh" "$2"
      ;;
    list-lxc-targets)
      [[ $# -eq 1 ]] || fail "list-lxc-targets does not accept additional arguments"
      config_get "$CONFIG_FILE" || exit 1
      list_lxc_targets
      ;;
    inspect-target)
      [[ $# -eq 2 ]] || fail "inspect-target requires exactly one VMID or name"
      config_get "$CONFIG_FILE" || exit 1
      inspect_lxc_target "$2"
      ;;
    plan-target)
      [[ $# -eq 2 ]] || fail "plan-target requires exactly one VMID or name"
      config_get "$CONFIG_FILE" || exit 1
      plan_lxc_target "$2"
      ;;
    protect-target)
      [[ $# -ge 2 && $# -le 3 ]] || fail "protect-target requires TARGET and optional --dry-run"
      dry_run=false
      if [[ $# -eq 3 ]]; then
        [[ "$3" == --dry-run ]] || fail "unknown protect-target option '$3'"
        dry_run=true
      fi
      config_get "$CONFIG_FILE" || exit 1
      protect_lxc_target "$2" "$dry_run"
      ;;
    help|-h|--help)
      usage
      ;;
    '')
      usage
      exit 1
      ;;
    *)
      fail "unknown command '$command'"
      ;;
  esac
}

main "$@"
