#!/bin/bash

set -u

CONFIG_FILE="/etc/proxmox-forge/forge.conf"

readonly -a REQUIRED_KEYS=(
  UPDATE_HOST
  UPDATE_LXC
  UPDATE_VM
  UPDATE_EXTERNAL
  UPDATE_RUNNING_LXC
  UPDATE_STOPPED_LXC
  CONTINUE_AFTER_TARGET_FAILURE
  UPDATE_LXC_OS
  UPDATE_LXC_APPLICATION
  RUN_CUSTOM_SCRIPTS
  CUSTOM_SCRIPTS_DIR
  PREFLIGHT
  PROTECTION
  ROLLBACK_ON_FAILURE
  HEALTH_CHECK
  LOG_DIR
  LOG_KEEP
)

readonly -a OPTIONAL_KEYS=(
  UPDATE_ONLY
  UPDATE_EXCLUDE
)

readonly -a BOOLEAN_KEYS=(
  UPDATE_HOST
  UPDATE_LXC
  UPDATE_VM
  UPDATE_EXTERNAL
  UPDATE_RUNNING_LXC
  UPDATE_STOPPED_LXC
  CONTINUE_AFTER_TARGET_FAILURE
  UPDATE_LXC_OS
  UPDATE_LXC_APPLICATION
  RUN_CUSTOM_SCRIPTS
  PREFLIGHT
  PROTECTION
  ROLLBACK_ON_FAILURE
  HEALTH_CHECK
)

declare -A CONFIG=()
declare -A SEEN=()

fail() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

is_known_key() {
  local wanted="$1" key

  for key in "${REQUIRED_KEYS[@]}" "${OPTIONAL_KEYS[@]}"; do
    [[ "$key" == "$wanted" ]] && return 0
  done

  return 1
}

trim() {
  local value="$1"

  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "$value"
}

parse_value() {
  local raw
  raw="$(trim "$1")"

  if [[ "$raw" =~ ^\"([^\"]*)\"$ ]]; then
    printf '%s' "${BASH_REMATCH[1]}"
    return 0
  fi

  if [[ "$raw" =~ ^\'([^\']*)\'$ ]]; then
    printf '%s' "${BASH_REMATCH[1]}"
    return 0
  fi

  if [[ "$raw" =~ [[:space:]] ]]; then
    return 1
  fi

  printf '%s' "$raw"
}

load_config() {
  local line line_number=0 key raw_value value

  [[ -r "$CONFIG_FILE" ]] || fail "configuration file is not readable: $CONFIG_FILE"

  while IFS= read -r line || [[ -n "$line" ]]; do
    ((line_number += 1))
    line="$(trim "$line")"

    [[ -z "$line" || "${line:0:1}" == "#" ]] && continue

    if [[ ! "$line" =~ ^([A-Z][A-Z0-9_]*)=(.*)$ ]]; then
      fail "invalid configuration syntax at $CONFIG_FILE:$line_number"
    fi

    key="${BASH_REMATCH[1]}"
    raw_value="${BASH_REMATCH[2]}"

    is_known_key "$key" || fail "unknown configuration key '$key' at $CONFIG_FILE:$line_number"
    [[ -z "${SEEN[$key]+x}" ]] || fail "duplicate configuration key '$key' at $CONFIG_FILE:$line_number"

    value="$(parse_value "$raw_value")" || fail "invalid value for '$key' at $CONFIG_FILE:$line_number"

    CONFIG["$key"]="$value"
    SEEN["$key"]=1
  done < "$CONFIG_FILE"
}

validate_boolean() {
  local key="$1" value="${CONFIG[$1]}"

  case "$value" in
    true|false) ;;
    *) fail "$key must be true or false (got '$value')" ;;
  esac
}

validate_config() {
  local key

  for key in "${REQUIRED_KEYS[@]}"; do
    [[ -n "${SEEN[$key]+x}" ]] || fail "missing required configuration key '$key'"
  done

  for key in "${BOOLEAN_KEYS[@]}"; do
    validate_boolean "$key"
  done

  [[ "${CONFIG[CUSTOM_SCRIPTS_DIR]}" == /* ]] || \
    fail "CUSTOM_SCRIPTS_DIR must be an absolute path"

  [[ "${CONFIG[LOG_DIR]}" == /* ]] || \
    fail "LOG_DIR must be an absolute path"

  [[ "${CONFIG[LOG_KEEP]}" =~ ^[1-9][0-9]*$ ]] || \
    fail "LOG_KEEP must be a positive integer"
}

usage() {
  cat <<'EOF'
Usage: forge COMMAND

Commands:
  validate-config   Load and validate the complete Forge configuration.
  help              Show this help.
EOF
}

main() {
  local command="${1:-}"

  case "$command" in
    validate-config)
      [[ $# -eq 1 ]] || fail "validate-config does not accept additional arguments"
      load_config
      validate_config
      printf 'Forge configuration OK: %s\n' "$CONFIG_FILE"
      ;;
    help|-h|--help)
      usage
      ;;
    '')
      usage
      exit 1
      ;;
    *)
      fail "unknown command '$command'"
      ;;
  esac
}

main "$@"
