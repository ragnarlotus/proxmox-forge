#!/bin/bash

set -u

CONFIG_FILE="/etc/proxmox-forge/forge.conf"

readonly -a REQUIRED_KEYS=(
  UPDATE_HOST
  UPDATE_LXC
  UPDATE_VM
  UPDATE_EXTERNAL
  UPDATE_RUNNING_LXC
  UPDATE_STOPPED_LXC
  CONTINUE_AFTER_TARGET_FAILURE
  UPDATE_LXC_OS
  UPDATE_LXC_APPLICATION
  RUN_CUSTOM_SCRIPTS
  CUSTOM_SCRIPTS_DIR
  PREFLIGHT
  PROTECTION
  ROLLBACK_ON_FAILURE
  HEALTH_CHECK
  LOG_DIR
  LOG_KEEP
)

readonly -a OPTIONAL_KEYS=(
  UPDATE_ONLY
  UPDATE_EXCLUDE
)

readonly -a BOOLEAN_KEYS=(
  UPDATE_HOST
  UPDATE_LXC
  UPDATE_VM
  UPDATE_EXTERNAL
  UPDATE_RUNNING_LXC
  UPDATE_STOPPED_LXC
  CONTINUE_AFTER_TARGET_FAILURE
  UPDATE_LXC_OS
  UPDATE_LXC_APPLICATION
  RUN_CUSTOM_SCRIPTS
  PREFLIGHT
  PROTECTION
  ROLLBACK_ON_FAILURE
  HEALTH_CHECK
)

declare -A CONFIG=()
declare -A SEEN=()

fail() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

is_known_key() {
  local wanted="$1" key

  for key in "${REQUIRED_KEYS[@]}" "${OPTIONAL_KEYS[@]}"; do
    [[ "$key" == "$wanted" ]] && return 0
  done

  return 1
}

trim() {
  local value="$1"

  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "$value"
}

parse_value() {
  local raw
  raw="$(trim "$1")"

  if [[ "$raw" =~ ^\"([^\"]*)\"$ ]]; then
    printf '%s' "${BASH_REMATCH[1]}"
    return 0
  fi

  if [[ "$raw" =~ ^\'([^\']*)\'$ ]]; then
    printf '%s' "${BASH_REMATCH[1]}"
    return 0
  fi

  if [[ "$raw" =~ [[:space:]] ]]; then
    return 1
  fi

  printf '%s' "$raw"
}

load_config() {
  local line line_number=0 key raw_value value

  [[ -r "$CONFIG_FILE" ]] || fail "configuration file is not readable: $CONFIG_FILE"

  while IFS= read -r line || [[ -n "$line" ]]; do
    ((line_number += 1))
    line="$(trim "$line")"

    [[ -z "$line" || "${line:0:1}" == "#" ]] && continue

    if [[ ! "$line" =~ ^([A-Z][A-Z0-9_]*)=(.*)$ ]]; then
      fail "invalid configuration syntax at $CONFIG_FILE:$line_number"
    fi

    key="${BASH_REMATCH[1]}"
    raw_value="${BASH_REMATCH[2]}"

    is_known_key "$key" || fail "unknown configuration key '$key' at $CONFIG_FILE:$line_number"
    [[ -z "${SEEN[$key]+x}" ]] || fail "duplicate configuration key '$key' at $CONFIG_FILE:$line_number"

    value="$(parse_value "$raw_value")" || fail "invalid value for '$key' at $CONFIG_FILE:$line_number"

    CONFIG["$key"]="$value"
    SEEN["$key"]=1
  done < "$CONFIG_FILE"
}

validate_boolean() {
  local key="$1" value="${CONFIG[$1]}"

  case "$value" in
    true|false) ;;
    *) fail "$key must be true or false (got '$value')" ;;
  esac
}

validate_config() {
  local key

  for key in "${REQUIRED_KEYS[@]}"; do
    [[ -n "${SEEN[$key]+x}" ]] || fail "missing required configuration key '$key'"
  done

  for key in "${BOOLEAN_KEYS[@]}"; do
    validate_boolean "$key"
  done

  [[ "${CONFIG[CUSTOM_SCRIPTS_DIR]}" == /* ]] || \
    fail "CUSTOM_SCRIPTS_DIR must be an absolute path"

  [[ "${CONFIG[LOG_DIR]}" == /* ]] || \
    fail "LOG_DIR must be an absolute path"

  [[ "${CONFIG[LOG_KEEP]}" =~ ^[1-9][0-9]*$ ]] || \
    fail "LOG_KEEP must be a positive integer"
}

load_and_validate_config() {
  CONFIG=()
  SEEN=()
  load_config
  validate_config
}

lxc_name_from_config() {
  local config_file="$1"
  sed -n 's/^hostname:[[:space:]]*//p' "$config_file" | head -n 1
}

resolve_lxc_target() {
  local target="$1" vmid="" name="" state="" config_file=""
  local candidate candidate_name
  local -a matches=()

  command -v pct >/dev/null 2>&1 || fail "pct is not available; Forge target resolution must run on a Proxmox VE host"
  [[ -d /etc/pve/lxc ]] || fail "/etc/pve/lxc is not available; Forge cannot discover local LXC containers"

  if [[ "$target" =~ ^[0-9]+$ ]]; then
    vmid="$target"
    config_file="/etc/pve/lxc/${vmid}.conf"
    [[ -f "$config_file" ]] || fail "no LXC exists with exact VMID '$target'"
  else
    shopt -s nullglob
    for candidate in /etc/pve/lxc/*.conf; do
      candidate_name="$(lxc_name_from_config "$candidate")"
      [[ "$candidate_name" == "$target" ]] || continue
      matches+=("${candidate##*/}")
    done
    shopt -u nullglob

    case "${#matches[@]}" in
      0)
        fail "no LXC exists with exact name '$target'"
        ;;
      1)
        vmid="${matches[0]%.conf}"
        config_file="/etc/pve/lxc/${vmid}.conf"
        ;;
      *)
        printf -v candidate '%s, ' "${matches[@]%.conf}"
        candidate="${candidate%, }"
        fail "LXC name '$target' is ambiguous; exact matches: VMIDs $candidate"
        ;;
    esac
  fi

  name="$(lxc_name_from_config "$config_file")"
  [[ -n "$name" ]] || fail "LXC $vmid has no hostname in $config_file"

  state="$(pct status "$vmid")" || fail "could not read state for LXC $vmid"
  state="${state#status: }"

  if grep -Eq '^template:[[:space:]]*1([[:space:]]|$)' "$config_file"; then
    printf 'type=lxc vmid=%s name=%s state=%s template=true\n' "$vmid" "$name" "$state"
  else
    printf 'type=lxc vmid=%s name=%s state=%s template=false\n' "$vmid" "$name" "$state"
  fi
}

usage() {
  cat <<'EOF'
Usage: forge COMMAND [ARGUMENTS]

Commands:
  validate-config        Load and validate the complete Forge configuration.
  resolve-target TARGET  Resolve one local LXC by exact VMID or exact name.
  help                   Show this help.
EOF
}

main() {
  local command="${1:-}"

  case "$command" in
    validate-config)
      [[ $# -eq 1 ]] || fail "validate-config does not accept additional arguments"
      load_and_validate_config
      printf 'Forge configuration OK: %s\n' "$CONFIG_FILE"
      ;;
    resolve-target)
      [[ $# -eq 2 ]] || fail "resolve-target requires exactly one VMID or name"
      load_and_validate_config
      resolve_lxc_target "$2"
      ;;
    help|-h|--help)
      usage
      ;;
    '')
      usage
      exit 1
      ;;
    *)
      fail "unknown command '$command'"
      ;;
  esac
}

main "$@"
