[Unit]
Description=Proxmox Forge - optional scheduled update timer

[Timer]
# User-selected maintenance window: Friday night / early Saturday, Madrid local time.
# Neither this timer nor any targets are enabled by installation.
OnCalendar=Sat *-*-* 04:00:00 Europe/Madrid
Persistent=false
Unit=proxmox-forge-update.service

[Install]
WantedBy=timers.target
