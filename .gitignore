# Local Forge configuration overrides are host-specific and must not be versioned.
forge.conf

# Target-specific local custom scripts are intentionally not versioned.
scripts.d/*
!scripts.d/README.md

# Host-local functional health checks are managed independently of custom updaters.
health.d/*
!health.d/README.md

# Generated Python bytecode must not make self-update report a dirty checkout.
__pycache__/
*.py[cod]
