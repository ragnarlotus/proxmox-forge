# Forge — default configuration
#
# This file is versioned and defines Forge's complete default configuration.
# Local host-specific changes belong in ./forge.conf, which is optional and
# loaded afterwards. Values defined there override these defaults.
#
# Do not edit this file for local customization: git updates may change it.


# -----------------------------------------------------------------------------
# Scope
# -----------------------------------------------------------------------------

# Update the local Proxmox host.
UPDATE_HOST=true

# Include currently running LXC containers in the automatic list/update-all
# scope. Explicit 'forge lxc update TARGET' requests do not depend on this setting.
UPDATE_RUNNING_LXC=true

# Stopped LXC containers are excluded from automatic list/update-all scope.
# When explicitly targeted with 'forge lxc update TARGET', a stopped LXC is started
# temporarily, updated, then returned to stopped state.

# Proxmox LXC templates are never update targets. They are clone/template
# sources, not Community Scripts application-update helpers.


# -----------------------------------------------------------------------------
# Selection
# -----------------------------------------------------------------------------

# A single guest must be selectable at invocation time by exact Proxmox VMID or
# exact guest name. Partial, fuzzy or prefix matching is not allowed. A name
# that does not match exactly must fail instead of selecting another target.
# If an exact name is ambiguous, target resolution must also fail.
# This is a runtime argument, not persistent configuration.


# -----------------------------------------------------------------------------
# Execution and failure semantics
# -----------------------------------------------------------------------------

# Forge runs are started manually in the initial scope. There are no scheduled
# jobs or background update jobs.
#
# Update operations themselves are deterministic and non-interactive: Forge
# must supply the package-manager/helper options needed to prevent prompts.
# Conditions that require a decision or additional resources are handled by
# configuration/requirements checks or reported as failures; they are not
# interactive questions during an update.

# Failure is isolated per guest target. If one LXC fails, Forge reports that
# target as failed, attempts recovery when applicable, and continues processing
# the remaining selected targets.

# The local Proxmox host is not rollback-capable through Forge. Host failures
# must be reported as failures; Forge must not pretend that guest rollback
# semantics apply to the host.


# -----------------------------------------------------------------------------
# LXC update stages
# -----------------------------------------------------------------------------

# Update the container operating system/packages.
UPDATE_LXC_OS=true

# Run the application updater installed by Proxmox Community Scripts when one
# is present and supported.
UPDATE_LXC_APPLICATION=true

# Run Forge-managed custom scripts for the target after its normal update.
# Custom scripts live in the project-root scripts.d/<VMID>/ directory.
RUN_CUSTOM_SCRIPTS=true
CUSTOM_SCRIPTS_DIR="/opt/proxmox-forge/scripts.d"


# -----------------------------------------------------------------------------
# Requirements and recovery
# -----------------------------------------------------------------------------

# Forge must load and validate the complete merged configuration and resolve all
# selected targets before performing any mutating operation. Invalid or unknown
# required configuration must fail before the first target is changed.

# LXC requirements are always checked before creating a backup or updating.

# Create a Proxmox host configuration backup immediately before a host update.
# Forge derives the destination from the single backup storage used by enabled
# Proxmox backup jobs on the local node, then stores host archives below its
# pve/ directory. Host backup failure prevents the host update from starting.
CREATE_BACKUP_BEFORE_HOST_UPDATE=true

# Additional absolute paths to include in Forge host configuration backups,
# separated by commas. The built-in paths /etc/, /root, /var/lib/pve-cluster,
# /usr/local/bin and /opt/proxmox-forge/scripts.d/ are always included.
# The optional /opt/proxmox-forge/forge.conf is included when present.
# Configured extra paths must exist; a missing path makes the host backup fail
# instead of being skipped silently.
# Example: HOST_BACKUP_EXTRA_PATHS="/opt/custom,/srv/config"
HOST_BACKUP_EXTRA_PATHS=""

# Create a recovery backup immediately before the LXC update starts.
#
# Proxmox is authoritative for backup behaviour. Forge must read and respect
# the existing Proxmox guest/storage/backup configuration instead of defining
# its own backup mode, storage or mount-point inclusion policy.
CREATE_BACKUP_BEFORE_LXC_UPDATE=true

# If a required update/health stage fails and a safe same-run recovery point is
# available, Forge attempts to restore that guest before continuing. This does
# not apply to the Proxmox host itself.
ROLLBACK_ON_FAILURE=true

# Validate target health after mutation before declaring success.
HEALTH_CHECK=true


# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

LOG_DIR="/var/log/proxmox-forge"

# Host logs are stored as:
#   LOG_DIR/<PVE_FQDN>/host/common.log
#   LOG_DIR/<PVE_FQDN>/host/error.log
# LXC logs are stored as:
#   LOG_DIR/<PVE_FQDN>/lxc/<VMID>/<TIMESTAMP>.log
# LOG_KEEP applies to the timestamped LXC logs.
LOG_KEEP=8
