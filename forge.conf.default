# Forge — default configuration
#
# This file is versioned and defines Forge's complete default configuration.
# Local host-specific changes belong in ./forge.conf, which is optional and
# loaded afterwards. Values defined there override these defaults.
#
# Do not edit this file for local customization: git updates may change it.


# -----------------------------------------------------------------------------
# Scope
# -----------------------------------------------------------------------------

# Update the local Proxmox host.
UPDATE_HOST=true

# Include currently running LXC containers in the automatic list/update-all
# scope. Explicit 'forge lxc update TARGET' requests do not depend on this setting.
UPDATE_RUNNING_LXC=true

# Stopped LXC containers are excluded from automatic list/update-all scope.
# When explicitly targeted with 'forge lxc update TARGET', a stopped LXC is started
# temporarily, updated, then returned to stopped state.

# Proxmox LXC templates are never update targets. They are clone/template
# sources, not Community Scripts application-update helpers.


# -----------------------------------------------------------------------------
# Selection
# -----------------------------------------------------------------------------

# A single guest must be selectable at invocation time by exact Proxmox VMID or
# exact guest name. Partial, fuzzy or prefix matching is not allowed. A name
# that does not match exactly must fail instead of selecting another target.
# If an exact name is ambiguous, target resolution must also fail.
# This is a runtime argument, not persistent configuration.

# Exclude running LXCs from automatic selection by exact VMID or hostname.
# Comma-separated entries, e.g. EXCLUDE="108,share". Explicit updates ignore it.
EXCLUDE=""


# -----------------------------------------------------------------------------
# Execution and failure semantics
# -----------------------------------------------------------------------------

# Manual update commands remain interactive. F121 can optionally run a
# separately authorized scheduled scope through systemd; its timer is never
# installed or enabled automatically.
#
# Scheduled scope is independent of UPDATE_HOST/UPDATE_RUNNING_LXC. Only
# explicitly authorized running VMIDs (not names) may be updated by the timer.
# Empty/default values authorize nothing. EXCLUDE still applies; stopped guests
# and templates are never started or updated by scheduled runs.
SCHEDULED_UPDATE_HOST=false
SCHEDULED_UPDATE_LXC=""

# F131: persist manually launched host/LXC/bulk updates across SSH disconnects
# while keeping their live terminal output through a reattachable tmux session.
# When enabled, unsupported/unavailable persistence aborts before any update.
# Other CLI commands, self-update and scheduled updates never use tmux.
# After reconnecting, use 'forge back' to reattach to an active update.
PERSISTENT_UPDATE_SESSION=false
#
#
# Update operations themselves are deterministic and non-interactive: Forge
# must supply the package-manager/helper options needed to prevent prompts.
# Conditions that require a decision or additional resources are handled by
# configuration/requirements checks or reported as failures; they are not
# interactive questions during an update.

# Failure is isolated per guest target. If one LXC fails, Forge reports that
# target as failed, attempts recovery when applicable, and continues processing
# the remaining selected targets.

# The local Proxmox host is not rollback-capable through Forge. Host failures
# must be reported as failures; Forge must not pretend that guest rollback
# semantics apply to the host.


# -----------------------------------------------------------------------------
# LXC update stages
# -----------------------------------------------------------------------------

# Update the container operating system/packages.
UPDATE_LXC_OS=true

# Run the application updater installed by Proxmox Community Scripts when one
# is present and supported.
UPDATE_LXC_APPLICATION=true

# Run Forge-managed custom scripts for the target after its normal update.
# Custom scripts live in the project-root scripts.d/<VMID>/ directory.
RUN_CUSTOM_SCRIPTS=true
CUSTOM_SCRIPTS_DIR="/opt/proxmox-forge/scripts.d"

# F234: opt-in minimum CPU/RAM limits for each LXC update. A nonzero value
# temporarily increases an explicitly configured Proxmox limit only when lower.
# Settings are restored before health validation / rollback and on normal exit.
# 0 = leave this dimension unchanged. Forge never lowers original limits.
# Example local forge.conf: LXC_UPDATE_TEMP_CORES=4; LXC_UPDATE_TEMP_MEMORY_MB=4096
LXC_UPDATE_TEMP_CORES=0
LXC_UPDATE_TEMP_MEMORY_MB=0


# -----------------------------------------------------------------------------
# Requirements and recovery
# -----------------------------------------------------------------------------

# Forge must load and validate the complete merged configuration and resolve all
# selected targets before performing any mutating operation. Invalid or unknown
# required configuration must fail before the first target is changed.

# Require this much free space (MiB) on / before host and LXC updates.
# A local override may change this threshold.
MIN_ROOT_FREE_MB=1024

# Require at least this many MiB of MemAvailable before host/LXC updates.
# Local overrides can adjust the minimum for the installed workloads.
MIN_MEM_AVAILABLE_MB=128

# LXC requirements are always checked before creating a backup or updating.

# Create a Proxmox host configuration backup immediately before a host update.
# Forge derives the destination from the single backup storage used by enabled
# Proxmox backup jobs on the local node, then stores host archives below its
# pve/ directory. Host backup failure prevents the host update from starting.
CREATE_BACKUP_BEFORE_HOST_UPDATE=true

# Additional absolute paths to include in Forge host configuration backups,
# separated by commas. The built-in paths /etc/, /root, /var/lib/pve-cluster,
# /usr/local/bin, /opt/proxmox-forge/scripts.d/ and
# /opt/proxmox-forge/health.d/ are always included.
# The optional /opt/proxmox-forge/forge.conf is included when present.
# Configured extra paths must exist; a missing path makes the host backup fail
# instead of being skipped silently.
# Example: HOST_BACKUP_EXTRA_PATHS="/opt/custom,/srv/config"
HOST_BACKUP_EXTRA_PATHS=""

# Required: create a recovery backup immediately before an LXC mutation.
#
# Proxmox is authoritative for backup behaviour. Forge must read and respect
# the existing Proxmox guest/storage/backup configuration instead of defining
# its own backup mode, storage or mount-point inclusion policy.
CREATE_BACKUP_BEFORE_LXC_UPDATE=true

# Forge uses only the same-run vzdump backup for recovery; it creates no
# persistent LXC snapshots. With rollback enabled, preflight refuses an
# overwrite restore that would destroy existing persistent snapshots.

# If a required update/health stage fails and a safe same-run recovery point is
# available, Forge attempts to restore that guest before continuing. This does
# not apply to the Proxmox host itself.
ROLLBACK_ON_FAILURE=true

# Validate target health after mutation before declaring success.
HEALTH_CHECK=true

# Optional per-LXC functional checks (health.d/<VMID>/*.sh).
# They run inside the guest after generic health checks and again after rollback.
# A missing target directory means no additional checks. HEALTH_CHECK=false
# disables both generic and functional checks during a normal update.
HEALTH_SCRIPTS_DIR="/opt/proxmox-forge/health.d"


# -----------------------------------------------------------------------------
# Notifications (F153/F154/F237)
# -----------------------------------------------------------------------------

# Deliver a single final email through the host's existing Proxmox root-mail
# forwarding and notification matcher. No dedicated SMTP credentials or
# recipient list are maintained by Forge.
EMAIL_NOTIFICATIONS=false

# Independent manual/scheduled policies: none (never), errors (FAILED/PARTIAL),
# all (including SUCCESS and no-selected runs). The email master switch above
# always takes precedence. Scheduled updates must still be explicitly enabled.
NOTIFY_MANUAL=errors
NOTIFY_SCHEDULED=all


# -----------------------------------------------------------------------------
# Forge self-update (F238)
# -----------------------------------------------------------------------------

# Before a manually invoked host/LXC/bulk update, check the tracked Git remote
# for a newer Forge main revision and offer to update Forge first. When false,
# Forge never performs version checks automatically. Prompts require a terminal;
# scheduled and noninteractive update runs never self-update or block on input.
# The explicit "forge update self-update [BRANCH]" command is independent.
CHECK_FORGE_UPDATES_BEFORE_UPDATE=true


# -----------------------------------------------------------------------------
# Presentation language (F246)
# -----------------------------------------------------------------------------

# Human-facing CLI, progress, history and notifications; no effect on raw
# technical logs or machine-readable record/JSON field names.
# Supported: en (default), es. Additional translations can be added later.
LANGUAGE=en

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

LOG_DIR="/var/log/proxmox-forge"

# Host logs are stored as:
#   LOG_DIR/<PVE_FQDN>/host/common.log (active; archived as common_<TIMESTAMP>_<PID>.log)
#   LOG_DIR/<PVE_FQDN>/host/error.log (active; archived as error_<TIMESTAMP>_<PID>.log)
# LXC logs are stored as:
#   LOG_DIR/<PVE_FQDN>/lxc/<VMID>/<TIMESTAMP>.log
# General update run logs are stored as:
#   LOG_DIR/<PVE_FQDN>/runs/<RUN_ID>.log
# LOG_KEEP applies independently to each host log stream (active + archives),
# timestamped LXC logs and general run logs.
LOG_KEEP=8
